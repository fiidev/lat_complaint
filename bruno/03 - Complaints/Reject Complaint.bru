meta {
  name: Admin - Reject Complaint
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/admin/complaints/{{complaint_id}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "rejection_reason": "Deskripsi masalah tidak jelas atau bukti fisik tidak ditemukan."
  }
}
