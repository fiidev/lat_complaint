meta {
  name: Staff or Admin - Add Progress Note
  type: http
  seq: 3
}

post {
  url: {{base_url}}/tickets/{{ticket_id}}/histories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staff_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "note": "Replacement part ordered; expected arrival tomorrow."
  }
}
