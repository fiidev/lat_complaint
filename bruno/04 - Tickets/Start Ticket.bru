meta {
  name: Staff - Start Ticket
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/tickets/{{ticket_id}}/start
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staff_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "note": "Initial inspection started."
  }
}
