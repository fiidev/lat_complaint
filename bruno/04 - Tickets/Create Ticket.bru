meta {
  name: Admin - Create & Assign Ticket
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/complaints/{{complaint_id}}/tickets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "assigned_to": 2,
    "priority": "high",
    "note": "Perbaiki stop kontak di Lab Komputer 1 segera."
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("ticket_id", res.body.data.id);
  }
}
