meta {
  name: Staff - Resolve Ticket
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/tickets/{{ticket_id}}/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staff_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "resolution_notes": "Stop kontak baru telah dipasang dan diuji dengan multimeter. Berfungsi normal."
  }
}
